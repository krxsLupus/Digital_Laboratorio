module sumador_restador4b (
    input wire [3:0] a,
    input wire [3:0] b,
    input wire sel,
    output wire [3:0] resultado,
    output wire carryOut
);

    wire [3:0] bXor;

    // Compuertas XOR: Invierten 'b' si sel = 1 (Resta), lo dejan igual si sel = 0 (Suma)
    assign bXor[0] = b[0] ^ sel;
    assign bXor[1] = b[1] ^ sel;
    assign bXor[2] = b[2] ^ sel;
    assign bXor[3] = b[3] ^ sel;

    // Instancia del sumador de 4 bits reutilizado
    sumador4b sum_rest_inst (
        .a(a),
        .b(bXor),
        .carryIn(sel),        // Al restar, sel=1 suma el "1" para el complemento a 2
        .suma(resultado),
        .carryOut(carryOut)
    );

endmodule