set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE10E22C8
set_global_assignment -name TOP_LEVEL_ENTITY top_sintetizador
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "11:24:35  OCTOBER 22, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Altera FPGA (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
# Filas
set_location_assignment PIN_49 -to rows_tec[0]
set_location_assignment PIN_44 -to rows_tec[1]
set_location_assignment PIN_42 -to rows_tec[2]
set_location_assignment PIN_39 -to rows_tec[3]

# Columnas
set_location_assignment PIN_34 -to cols_tec[0]
set_location_assignment PIN_32 -to cols_tec[1]
set_location_assignment PIN_30 -to cols_tec[2]

# Pines clock y reset
set_location_assignment PIN_23 -to clk
set_location_assignment PIN_90 -to rst

# Pines Encoder 1
set_location_assignment PIN_28 -to pin_a
set_location_assignment PIN_31 -to pin_b

# Pines VGA
set_location_assignment PIN_142 -to vga_hs
set_location_assignment PIN_143 -to vga_vs
set_location_assignment PIN_2 -to vga_r
set_location_assignment PIN_1 -to vga_g
set_location_assignment PIN_144 -to vga_b


# seg[6:0] (119 a 127) y dig[3:0] (128 a 133)
set_location_assignment PIN_127 -to seg[0]
set_location_assignment PIN_126 -to seg[1]
set_location_assignment PIN_125 -to seg[2]
set_location_assignment PIN_124 -to seg[3]
set_location_assignment PIN_121 -to seg[4]
set_location_assignment PIN_120 -to seg[5]
set_location_assignment PIN_119 -to seg[6]
set_location_assignment PIN_133 -to dig[3]
set_location_assignment PIN_132 -to dig[2]
set_location_assignment PIN_129 -to dig[1]
set_location_assignment PIN_128 -to dig[0]

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to cols_tec[0]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to cols_tec[1]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to cols_tec[2]
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cols_tec[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rows_tec[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pin_a
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pin_b
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dac[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to buzzer
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dig[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_hs
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_vs
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_r
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_g
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_b
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to i2s_bclk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to i2s_lrclk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to i2s_din
set_location_assignment PIN_51 -to i2s_bclk
set_location_assignment PIN_53 -to i2s_lrclk
set_location_assignment PIN_55 -to i2s_din
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH tb_voces -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_NAME tb_teclado_4x3 -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_teclado_4x3
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_teclado_4x3 -section_id tb_teclado_4x3
set_global_assignment -name EDA_TEST_BENCH_NAME tb_polifonia -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_polifonia
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_polifonia -section_id tb_polifonia
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vol_a
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vol_b
set_location_assignment PIN_33 -to vol_a
set_location_assignment PIN_38 -to vol_b
set_global_assignment -name SDC_FILE Sintetizador.sdc
set_global_assignment -name VERILOG_FILE src/acumulador_fase.v
set_global_assignment -name VERILOG_FILE src/banco_notas.v
set_global_assignment -name VERILOG_FILE src/bcd_7s.v
set_global_assignment -name VERILOG_FILE src/encoder_ky040.v
set_global_assignment -name VERILOG_FILE src/encoder_volumen.v
set_global_assignment -name VERILOG_FILE src/generador_notas.v
set_global_assignment -name VERILOG_FILE src/generador_onda.v
set_global_assignment -name VERILOG_FILE src/i2s_tx.v
set_global_assignment -name VERILOG_FILE src/lut_frecuencias.v
set_global_assignment -name VERILOG_FILE src/salida_i2s.v
set_global_assignment -name VERILOG_FILE src/seno_lut.v
set_global_assignment -name VERILOG_FILE src/teclado_poly.v
set_global_assignment -name VERILOG_FILE src/top_sintetizador.v
set_global_assignment -name VERILOG_FILE src/vga_draw.v
set_global_assignment -name VERILOG_FILE src/vga_sync.v
set_global_assignment -name EDA_TEST_BENCH_FILE src/tb_teclado_4x3.v -section_id tb_teclado_4x3
set_global_assignment -name EDA_TEST_BENCH_FILE tb_polifonia.v -section_id tb_polifonia
set_global_assignment -name EDA_TEST_BENCH_NAME tb_voces -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_voces
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_voces -section_id tb_voces
set_global_assignment -name EDA_TEST_BENCH_FILE tb_voces.v -section_id tb_voces

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top