module ctrl_param #(
    parameter integer ACTIVO_BAJO = 1
)(
    input  wire       clk,
    input  wire       rst,
    input  wire       enc_a,
    input  wire       enc_b,
    input  wire       btn,
    output reg  [3:0] a_idx   = 4'd3,  // 10 ms
    output reg  [3:0] d_idx   = 4'd8,  // 250 ms
    output reg  [3:0] s_idx   = 4'd12, // 0.75
    output reg  [3:0] r_idx   = 4'd8,  // 250 ms
    output reg  [3:0] eco_t   = 4'd7,  // ~125 ms
    output reg  [3:0] eco_fb  = 4'd6,  // ~0.35
    output reg  [3:0] eco_mix = 4'd0,  // Arranca limpio
    output reg  [3:0] rev_mix = 4'd0,
    output wire [7:0] led_sel,         // One-hot para 8 LEDs
    output reg  [3:0] valor
);

    wire btn_pulso;
    wire enc_up, enc_down;

    // Asume que tienes un detector de flancos o antirrebote para el botón aquí
    // y tu instancia de encoder_core.
    // encoder_core u_enc (.clk(clk), .rst(rst), .pin_a(enc_a), .pin_b(enc_b), .up(enc_up), .down(enc_down));

    reg [2:0] sel = 3'd0;
    assign led_sel = 8'b00000001 << sel;

    always @(posedge clk) begin
        if (rst) sel <= 3'd0;
        else if (btn_pulso) sel <= sel + 1'b1;
    end

    // Multiplexor de lectura y escritura simplificado
    always @(posedge clk) begin
        case (sel)
            3'd0: valor = a_idx;
            3'd1: valor = d_idx;
            3'd2: valor = s_idx;
            3'd3: valor = r_idx;
            3'd4: valor = eco_t;
            3'd5: valor = eco_fb;
            3'd6: valor = eco_mix;
            3'd7: valor = rev_mix;
        endcase

        // Lógica de incremento/decremento truncada a 4 bits (0 a 15)
        // if (enc_up)   /* sumar 1 al registro seleccionado sin pasar de 15 */
        // if (enc_down) /* restar 1 al registro seleccionado sin bajar de 0 */
    end
endmodule
