set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C6
set_global_assignment -name TOP_LEVEL_ENTITY top_remix
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_FILE ../src/top_remix.v
set_global_assignment -name VERILOG_FILE ../src/teclado.v
set_global_assignment -name VERILOG_FILE ../src/synth_voice.v
set_global_assignment -name VERILOG_FILE ../src/pwm_servo.v
set_global_assignment -name VERILOG_FILE ../src/codificador_pos.v
set_global_assignment -name SDC_FILE Slave_REMIX.sdc

# The project brief identifies the 50 MHz clock on PIN_23.
set_location_assignment PIN_23 -to CLK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to CLK_50

