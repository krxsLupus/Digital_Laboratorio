module encoder_ky040(
    input  wire       clk,
    input  wire       rst,
    input  wire       pin_a,     // Conectar al pin CLK del módulo KY-040
    input  wire       pin_b,     // Conectar al pin DT del módulo KY-040
    output reg  [1:0] sel_onda   // Valor de 0 a 2
);

    // Sincronizadores para señales asíncronas externas
    reg [2:0] a_sync, b_sync;
    always @(posedge clk) begin
        a_sync <= {a_sync[1:0], pin_a};
        b_sync <= {b_sync[1:0], pin_b};
    end

    wire a_estable = a_sync[2];
    wire b_estable = b_sync[2];
    
    reg a_prev;
    always @(posedge clk) begin
        a_prev <= a_estable;
    end

    // Detección de flanco de bajada en el pin A
    wire a_falling = (a_prev == 1'b1 && a_estable == 1'b0);

    always @(posedge clk) begin
        if (rst) begin
            sel_onda <= 2'd0;
        end else if (a_falling) begin
            if (b_estable != a_estable) begin
                // Giro horario
                if (sel_onda < 2'd2) sel_onda <= sel_onda + 1'b1;
                else                 sel_onda <= 2'd0;
            end else begin
                // Giro antihorario
                if (sel_onda > 2'd0) sel_onda <= sel_onda - 1'b1;
                else                 sel_onda <= 2'd2;
            end
        end
    end
endmodule